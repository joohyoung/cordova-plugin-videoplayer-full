{
  "name": "cordova-plugin-video-player-full",
  "version": "1.1.0",
  "description": "A Codova plugin that simply allows you to immediately play a video in fullscreen mode.",
  "cordova": {
    "id": "cordova-plugin-video-player-full",
    "platforms": [
      "android",
      "ios"
    ]
  },
  "engines": {
    "cordovaDependencies": {
      "2.0.0": {
        "cordova": ">100"
      }
    }
  },
  "scripts": {
    "test": "node tests/run-tests.js",
    "test:ios": "sh tests/run-ios-audio-session-tests.sh",
    "test:android": "sh tests/run-android-audio-policy-tests.sh",
    "test:release-skill": "sh tests/run-release-skill-tests.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joohyoung/cordova-plugin-videoplayer-full.git"
  },
  "keywords": [
    "ecosystem:cordova",
    "cordova-android",
    "cordova",
    "video",
    "player",
    "fullscreen"
  ],
  "author": "jhpark",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joohyoung/cordova-plugin-videoplayer-full/issues"
  },
  "homepage": "https://github.com/joohyoung/cordova-plugin-videoplayer-full#readme"
}
